DATABASE_URL="postgresql://user:password@host:5432/market_reaction_lab"

# App access (simple single-user password gate — this is a private research journal)
APP_ACCESS_PASSWORD="pick-a-password"
SESSION_SECRET="generate-a-random-string"

# Protects the /api/cron/* endpoints from being triggered by anyone who
# finds the URL. Any long random string; set the same value here and in
# your cron-job.org URL / Vercel's env vars.
CRON_SECRET="generate-a-random-string"

# --- Data providers -------------------------------------------------------
# Leave any of these blank to fall back to the mock provider for that source.
# See README.md "Going live" for where to get each one (all have free tiers).

# Stock prices + the company/ticker symbol directory used to match news
# articles to companies (NOT used for news content itself — see below).
# https://finnhub.io/register
FINNHUB_API_KEY=""

# General/mainstream news discovery — this is what actually drives "what's
# in the news" (spec §4). Free tier is thin (historically ~100 requests/day,
# 3 articles per request), which is why ingestDiscoveryCycle economizes on
# it — see the doc comment there. https://www.thenewsapi.com/register
THENEWSAPI_KEY=""

# Financial news, pre-tagged by ticker — https://www.marketaux.com
# Not used by default (discovery runs on general/mainstream news instead —
# see THENEWSAPI_KEY above and SPEC-NOTES.md "Discovery universe"). Safe to
# leave blank; kept here only if you want to re-enable financial-press
# coverage later (src/lib/providers/news/marketaux.ts still exists).
MARKETAUX_API_KEY=""

# Reddit (social attention) — https://www.reddit.com/prefs/apps (create a "script" app)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="market-reaction-lab/0.1 by <your-reddit-username>"

# YouTube (video attention) — https://console.cloud.google.com (enable "YouTube Data API v3")
YOUTUBE_API_KEY=""

# GDELT (global news-coverage volume, general-public attention) — free, no
# key required, but off by default: it's a research/academic resource, not
# a commercial SLA'd API, and is more prone to rate limiting than everything
# else here. Set to "true" to opt in. See src/lib/providers/social/gdelt.ts.
ENABLE_GDELT=""

# X / Twitter — requires a paid API tier (Basic, ~$200/mo) for search access.
# Leave blank; the app will report "Not available" for X until you add one.
X_BEARER_TOKEN=""

# Claude (Anthropic) API — powers the per-story "mainstream reach" read and
# person/company name extraction (see src/lib/llm/storyAnalysis.ts). This is
# a SEPARATE account/key from claude.ai — sign up and create a key at
# https://console.anthropic.com (requires billing info; usage is metered).
# Leave blank to skip this entirely — discovery still works via
# keyword-matching alone, just without executive/public-figure name
# resolution or a reach score.
ANTHROPIC_API_KEY=""
# Optional: override the model used for story analysis (defaults to a
# current cheap/fast model — see DEFAULT_MODEL in storyAnalysis.ts).
ANTHROPIC_MODEL=""

# Research Day 1 — set automatically on first run if unset. Do not backfill.
RESEARCH_DAY_ONE=""
