DATABASE_URL="postgresql://user:password@host:5432/market_reaction_lab"

# App access (simple single-user password gate — this is a private research journal)
APP_ACCESS_PASSWORD="pick-a-password"
SESSION_SECRET="generate-a-random-string"

# --- Data providers -------------------------------------------------------
# Leave any of these blank to fall back to the mock provider for that source.
# See README.md "Going live" for where to get each one (all have free tiers).

# Market data + company news — https://finnhub.io/register
FINNHUB_API_KEY=""

# Financial news, pre-tagged by ticker — https://www.marketaux.com
MARKETAUX_API_KEY=""

# Reddit (social attention) — https://www.reddit.com/prefs/apps (create a "script" app)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="market-reaction-lab/0.1 by <your-reddit-username>"

# YouTube (video attention) — https://console.cloud.google.com (enable "YouTube Data API v3")
YOUTUBE_API_KEY=""

# X / Twitter — requires a paid API tier (Basic, ~$200/mo) for search access.
# Leave blank; the app will report "Not available" for X until you add one.
X_BEARER_TOKEN=""

# Research Day 1 — set automatically on first run if unset. Do not backfill.
RESEARCH_DAY_ONE=""
